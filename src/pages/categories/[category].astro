---
import { getCollection } from 'astro:content';
import PostListPage from '../../components/PostListPage.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => p.id.startsWith('zh/'));
  const catSet = new Set<string>();
  for (const post of posts) {
    for (const cat of (post.data.categories || [])) catSet.add(cat);
  }
  return Array.from(catSet).map(category => ({
    params: { category },
    props: {
      category,
      posts: posts
        .filter(p => p.data.categories?.includes(category))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { category, posts } = Astro.props;
---
<PostListPage
  lang="zh"
  title={`分类：${category}`}
  posts={posts}
  altHref={`/en/categories/${encodeURIComponent(category)}`}
/>
