---
import { getCollection } from 'astro:content';
import PostPage from '../../components/PostPage.astro';
import { getPostSlug } from '../../utils/slug';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(p => p.id.startsWith('zh/'));
  return posts.map(post => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter(p => p.id.startsWith('zh/'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const idx = allPosts.findIndex(p => p.id === post.id);
const prev = idx > 0 ? allPosts[idx - 1] : null;
const next = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
---
<PostPage
  lang="zh"
  post={post}
  prev={prev}
  next={next}
  altHref={`/en/blog/${getPostSlug(post)}`}
/>
