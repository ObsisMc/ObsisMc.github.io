---
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  isPost?: boolean;
  lang?: 'zh' | 'en';
  altHref?: string;
}
const { title, isPost = false, lang = 'zh', altHref } = Astro.props;
const siteTitle = lang === 'zh' ? SITE.nameZh : SITE.nameEn;
const switchHref = altHref ?? (lang === 'zh' ? '/en/' : '/');
const canonicalURL = new URL(Astro.url.pathname, SITE.origin).href;
// For hreflang: current page is canonical for its own lang, altHref is the other lang's URL
const zhHref = lang === 'zh' ? Astro.url.pathname : (altHref ?? '/');
const enHref = lang === 'en' ? Astro.url.pathname : (altHref ?? '/en/');
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} class="h-full scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? `${title} | ${siteTitle}` : siteTitle}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="zh-CN" href={`${SITE.origin}${zhHref}`} />
  <link rel="alternate" hreflang="en" href={`${SITE.origin}${enHref}`} />
  <link rel="alternate" hreflang="x-default" href={`${SITE.origin}/`} />
  <!-- Anti-flash: apply dark class before first paint -->
  <script is:inline>
    (function(){try{var s=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme: dark)').matches;if(s==='dark'||(s===null&&d))document.documentElement.classList.add('dark');}catch(e){}})();
  </script>
  <!-- Google Analytics -->
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`}></script>
  <script is:inline define:vars={{ gaId: SITE.googleAnalyticsId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', gaId);
  </script>
  {isPost && (
    <>
      <style>.prose-shiro { max-width: 85ch !important; }</style>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/css/lightgallery.min.css" />
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/css/lg-zoom.min.css" />
      <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js"></script>
      <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/contrib/auto-render.min.js"
        onload="renderMathInElement(document.body,{delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false},{left:'\\[',right:'\\]',display:true},{left:'\\(',right:'\\)',display:false}]})"></script>
      <Fragment set:html={`<script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/lightgallery.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/lightgallery/2.8.3/plugins/zoom/lg-zoom.min.js"></script>`} />
    </>
  )}
</head>
<body class="h-full fog-bg text-slate-800">

  <!-- SVG filters for seal roughness / text erosion -->
  <svg width="0" height="0" class="absolute pointer-events-none" aria-hidden="true">
    <defs>
      <filter id="seal-roughness" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="turbulence" baseFrequency="0.05" numOctaves="2" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" />
      </filter>
      <filter id="text-erosion">
        <feTurbulence type="fractalNoise" baseFrequency="0.15" numOctaves="1" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.5" />
      </filter>
    </defs>
  </svg>

  <div class="min-h-full px-4 pt-14 pb-6 md:pb-5">

    <!-- Paper Card -->
    <div class="paper mx-auto w-full max-w-4xl rounded-2xl px-5 sm:px-8 md:px-12 lg:px-14 pt-10 pb-6 md:pt-12 md:pb-8">
      <slot />
    </div>

    <!-- Top-right controls: dark toggle + lang switcher -->
    <div class="lang-switcher" style="display:flex; align-items:center; gap:0.45rem;">

    <!-- Dark mode toggle -->
    <button id="darkToggleBtn" class="dark-toggle-btn" type="button" aria-label="Toggle dark mode">
      <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="5"/>
        <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
        <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
      </svg>
    </button>

    <div id="langSwitcher" data-open="false" style="position:relative;">
      <button id="langToggleBtn" class="lang-toggle-btn" type="button"
        aria-label="Switch language" aria-haspopup="listbox" aria-expanded="false">
        <span>{lang === 'zh' ? 'ZH' : 'EN'}</span>
        <span class="lang-toggle-chevron" aria-hidden="true"></span>
      </button>
      <div class="lang-dropdown" role="listbox" aria-label="Select language">
        <a class="lang-option" data-active={lang === 'zh' ? 'true' : 'false'}
          href={lang === 'zh' ? '#' : switchHref} role="option">中文</a>
        <a class="lang-option" data-active={lang === 'en' ? 'true' : 'false'}
          href={lang === 'en' ? '#' : switchHref} role="option">English</a>
      </div>
    </div>
    </div><!-- end top-right controls -->

    <!-- To-top button -->
    <button id="toTopBtn" class="to-top-btn" type="button" aria-label="回到顶部">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 5l-6 6 1.4 1.4L12 7.8l4.6 4.6L18 11zM12 11l-6 6 1.4 1.4L12 13.8l4.6 4.6L18 17z"/>
      </svg>
    </button>

    <!-- Tagline note -->
    <div class="mt-4 text-center">
      <p class="text-footnote tracking-note text-slate-400/70 font-light select-none"
         style="font-family:var(--font-title);">
        {SITE.tagline}
      </p>
    </div>
  </div>

  <script>
    // Dark mode toggle
    const darkToggleBtn = document.getElementById('darkToggleBtn');
    if (darkToggleBtn) {
      darkToggleBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
      });
    }

    // To-top button
    const toTopBtn = document.getElementById('toTopBtn');
    if (toTopBtn) {
      window.addEventListener('scroll', () => {
        toTopBtn.classList.toggle('is-visible', window.scrollY > 300);
      }, { passive: true });
      toTopBtn.addEventListener('click', () =>
        window.scrollTo({ top: 0, behavior: 'smooth' })
      );
    }

    // Lang switcher
    const langSwitcher = document.getElementById('langSwitcher');
    const langToggleBtn = document.getElementById('langToggleBtn');
    if (langSwitcher && langToggleBtn) {
      langToggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = langSwitcher.dataset.open === 'true';
        langSwitcher.dataset.open = String(!open);
        langToggleBtn.setAttribute('aria-expanded', String(!open));
      });
      document.addEventListener('click', (e) => {
        if (!langSwitcher.contains(e.target as Node)) {
          langSwitcher.dataset.open = 'false';
          langToggleBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Mobile menu
    const menuBtn = document.getElementById('menuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', () => {
        const open = mobileMenu.dataset.open === 'true';
        mobileMenu.dataset.open = String(!open);
        menuBtn.setAttribute('aria-expanded', String(!open));
        const chevron = menuBtn.querySelector('#menuChevron') as SVGElement | null;
        if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
      });
    }
  </script>
</body>
</html>
