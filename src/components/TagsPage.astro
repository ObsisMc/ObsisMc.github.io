---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Divider from './Divider.astro';

interface Props {
  lang: 'zh' | 'en';
  altHref: string;
}

const { lang, altHref } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';

const posts = (await getCollection('blog')).filter(p => p.id.startsWith(`${lang}/`));
const tagCount: Record<string, number> = {};
for (const post of posts) {
  for (const tag of (post.data.tags || [])) {
    tagCount[tag] = (tagCount[tag] || 0) + 1;
  }
}
const tags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]);

const title = 'Tags';
const emptyText = lang === 'zh' ? '暂无标签。' : 'No tags yet.';
---
<Base title={title} lang={lang} altHref={altHref}>
  <Header lang={lang} />
  <main class="section-divider">
    <section class="section-shell">
      <header class="section-header">
        <h1 class="section-title">{title}</h1>
        <Divider />
      </header>
      {tags.length > 0 ? (
        <div class="text-center mt-12 mb-16">
          <div class="flex flex-wrap justify-center gap-3">
            {tags.map(([tag, count]) => (
              <a href={`${prefix}/tags/${encodeURIComponent(tag)}`} class="tag-pill">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2" style="display:inline-block;"></span>
                {tag}
                <span class="text-slate-400 ml-1 text-xs">({count})</span>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <p class="text-center text-slate-400 mt-12">{emptyText}</p>
      )}
    </section>
  </main>
  <Footer />
</Base>
