---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getPostSlug } from '../utils/slug';
import { getGitLastModified } from '../utils/lastModified';

interface Props {
  lang: 'zh' | 'en';
  post: CollectionEntry<'blog'>;
  prev: CollectionEntry<'blog'> | null;
  next: CollectionEntry<'blog'> | null;
  altHref: string;
}

const { lang, post, prev, next, altHref } = Astro.props;
const { Content, headings } = await post.render();
const tocItems = headings.filter(h => h.depth <= 3);
const prefix = lang === 'en' ? '/en' : '';
const tocLabel = lang === 'zh' ? '目录' : 'Contents';
const giscusLang = lang === 'zh' ? 'zh-CN' : 'en';
const postSlug = getPostSlug(post);

const lastModified = getGitLastModified(post.id);
const showUpdated = lastModified &&
  lastModified.getTime() > post.data.date.getTime() + 86_400_000;
const updatedLabel = lang === 'zh' ? '更新于' : 'Updated';
const fmtDate = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '/');
---
<Base title={post.data.title} isPost={true} lang={lang} altHref={altHref}>
  <Header lang={lang} />
  <main class="section-divider">
    <article class="content-article">
      <header class="text-center mb-8">
        <h1 class="page-title mb-4">{post.data.title}</h1>
        <div class="mt-2 flex items-center justify-center gap-4 text-sm text-slate-500 mb-4">
          {post.data.categories && post.data.categories.length > 0 && (
            <>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <a href={`${prefix}/categories/${encodeURIComponent(post.data.categories[0])}`} class="link-muted">{post.data.categories[0]}</a>
              </div>
              <span class="text-slate-300" aria-hidden="true">•</span>
            </>
          )}
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span style="font-variant-numeric:oldstyle-nums;">{fmtDate(post.data.date)}</span>
          </div>
          {showUpdated && (
            <>
              <span class="text-slate-300" aria-hidden="true">•</span>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                <span style="font-variant-numeric:oldstyle-nums;">{updatedLabel} {fmtDate(lastModified!)}</span>
              </div>
            </>
          )}
        </div>
      </header>

      <div class="prose-shiro prose prose-slate">
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <a href={`${prefix}/tags/${encodeURIComponent(tag)}`} class="tag-pill">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-2" style="display:inline-block;"></span>
              {tag}
            </a>
          ))}
        </div>
      )}

      <!-- Giscus comments -->
      <div id="giscus-container" class="mt-12 pt-8 border-t border-slate-200/70">
        <Fragment set:html={`<script src="https://giscus.app/client.js"
          data-repo="ObsisMc/ObsisMc.github.io"
          data-repo-id="R_kgDORhNpVA"
          data-category="General"
          data-category-id="DIC_kwDORhNpVM4C37A7"
          data-mapping="specific"
          data-term="${postSlug}"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang="${giscusLang}"
          data-loading="lazy"
          crossorigin="anonymous"
          async></script>`} />
      </div>

      <!-- Post navigation -->
      <div class="mt-12 pt-8 border-t border-slate-200/70 flex justify-between items-center text-sm md:text-base">
        {prev ? (
          <a href={`${prefix}/blog/${getPostSlug(prev)}`} class="post-nav-link group text-left">
            <span aria-hidden="true">&larr;</span>
            <span class="post-nav-title">{prev.data.title}</span>
          </a>
        ) : <div></div>}
        {next ? (
          <a href={`${prefix}/blog/${getPostSlug(next)}`} class="post-nav-link group text-right">
            <span class="post-nav-title">{next.data.title}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        ) : <div></div>}
      </div>
    </article>
  </main>
  <Footer />

  <!-- Floating TOC (desktop ≥1200px) -->
  {tocItems.length > 0 && (
    <aside class="post-toc-float" aria-label={tocLabel}>
      <div class="post-toc" data-collapsed="false" data-pinned="true" id="postToc">
        <button class="post-toc-toggle" type="button" aria-expanded="true" id="tocToggle">
          <span class="post-toc-bookmark" aria-hidden="true">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M7.25 6.5a1 1 0 1 1-2 0a1 1 0 0 1 2 0zm0 5a1 1 0 1 1-2 0a1 1 0 0 1 2 0zm0 5a1 1 0 1 1-2 0a1 1 0 0 1 2 0zM10 6.5h9M10 11.5h9M10 16.5h9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/>
            </svg>
          </span>
          <span class="post-toc-title">{tocLabel}</span>
          <span class="post-toc-toggle-icon" aria-hidden="true"></span>
        </button>
        <div class="post-toc-body">
          <ul class="toc">
            {tocItems.map(h => (
              <li class:list={['toc-item', h.depth === 3 ? 'toc-child' : '']}>
                <a href={`#${h.slug}`} class="toc-link">
                  <span class="toc-text">{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="post-toc-resize-handle post-toc-resize-handle--left" aria-hidden="true"></div>
        <div class="post-toc-resize-handle post-toc-resize-handle--bottom" aria-hidden="true"></div>
      </div>
    </aside>
  )}
</Base>

<script>
  // LightGallery image viewer
  document.addEventListener('DOMContentLoaded', () => {
    const containers = document.querySelectorAll('.prose-shiro');
    if (!containers.length || typeof (window as any).lightGallery !== 'function') return;
    const zoomPlugin = (window as any).lgZoom || (window as any).LgZoom || null;
    let activeLgInstance: any = null;

    const escapeHtml = (v: string) => v.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    const getCaption = (img: HTMLImageElement) => img.getAttribute('title') || img.getAttribute('alt') || '';
    const ensureLink = (container: Element, img: HTMLImageElement) => {
      const src = img.currentSrc || img.src;
      if (!src) return null;
      const existing = img.closest('a');
      const link: HTMLAnchorElement = existing && container.contains(existing) ? existing as HTMLAnchorElement : document.createElement('a');
      if (!link.contains(img)) { img.parentNode!.insertBefore(link, img); link.appendChild(img); }
      link.setAttribute('href', src);
      link.setAttribute('data-lg-item', 'true');
      const cap = getCaption(img);
      if (cap) link.setAttribute('data-sub-html', `<p>${escapeHtml(cap)}</p>`);
      else link.removeAttribute('data-sub-html');
      return link;
    };

    containers.forEach((container) => {
      const images = container.querySelectorAll('img');
      if (!images.length) return;
      images.forEach((img) => ensureLink(container, img as HTMLImageElement));
      const instance = (window as any).lightGallery(container, {
        selector: 'a[data-lg-item]',
        download: false,
        plugins: zoomPlugin ? [zoomPlugin] : [],
        zoom: Boolean(zoomPlugin),
        actualSize: false,
        showZoomInOutIcons: Boolean(zoomPlugin),
      });
      container.addEventListener('lgAfterOpen', (e: any) => { activeLgInstance = e.detail?.instance || instance; });
      container.addEventListener('lgAfterClose', () => { activeLgInstance = null; });
    });

    document.addEventListener('wheel', (e) => {
      if (!activeLgInstance) return;
      const t = e.target as Element;
      if (!t.closest('.lg-outer')) return;
      e.preventDefault();
      const zoom = activeLgInstance.plugins?.zoom;
      if (zoom?.zoomIn && zoom?.zoomOut) { e.deltaY < 0 ? zoom.zoomIn() : zoom.zoomOut(); return; }
      const btn = document.querySelector(e.deltaY < 0 ? '.lg-zoom-in' : '.lg-zoom-out');
      btn?.dispatchEvent(new MouseEvent('click', { bubbles: true }));
    }, { passive: false });
  });

  const toc = document.getElementById('postToc') as HTMLElement | null;
  const toggle = document.getElementById('tocToggle');
  if (toc && toggle) {
    const tocEl = toc as HTMLElement;

    toggle.addEventListener('click', () => {
      const collapsed = tocEl.dataset.collapsed === 'true';
      tocEl.dataset.collapsed = String(!collapsed);
      toggle.setAttribute('aria-expanded', String(collapsed));
      tocEl.dataset.pinned = collapsed ? 'true' : 'false';
    });

    // Active link on scroll — highlight the last heading that has passed the top threshold
    const links = tocEl.querySelectorAll<HTMLAnchorElement>('.toc-link');
    const headingEls = Array.from(links).map(l => {
      const id = decodeURIComponent(l.href.split('#')[1] ?? '');
      return document.getElementById(id);
    }).filter((el): el is HTMLElement => el !== null);

    const THRESHOLD = 120; // px from viewport top
    const tocBody = tocEl.querySelector<HTMLElement>('.post-toc-body');

    function updateActiveToc() {
      let active: HTMLElement | null = null;
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top <= THRESHOLD) {
          active = el;
        }
      }
      links.forEach(l => l.classList.remove('is-active'));
      if (active) {
        const activeLink = tocEl.querySelector<HTMLElement>(`.toc-link[href="#${active.id}"]`);
        activeLink?.classList.add('is-active');
        if (activeLink && tocBody) {
          const linkTop = activeLink.offsetTop;
          const linkBottom = linkTop + activeLink.offsetHeight;
          const bodyTop = tocBody.scrollTop;
          const bodyBottom = bodyTop + tocBody.clientHeight;
          if (linkTop < bodyTop || linkBottom > bodyBottom) {
            tocBody.scrollTo({ top: linkTop - tocBody.clientHeight / 2, behavior: 'smooth' });
          }
        }
      }
    }

    window.addEventListener('scroll', updateActiveToc, { passive: true });
    updateActiveToc();
  }
</script>
