---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Divider from './Divider.astro';
import { getPostSlug } from '../utils/slug';

interface Props {
  lang: 'zh' | 'en';
  title: string;
  posts: CollectionEntry<'blog'>[];
  altHref: string;
}

const { lang, title, posts, altHref } = Astro.props;
const prefix = lang === 'en' ? '/en' : '';
---
<Base title={title} lang={lang} altHref={altHref}>
  <Header lang={lang} />
  <main class="section-divider">
    <section class="section-shell">
      <header class="section-header">
        <h1 class="section-title">{title}</h1>
        <Divider />
      </header>
      <div style="max-width:42rem; margin:0 auto;">
        {posts.map(post => (
          <article class="archive-item group" style="padding:0.4rem 0;">
            <time datetime={post.data.date.toISOString().slice(0,10)} class="archive-date">
              {post.data.date.toISOString().slice(0,10).replace(/-/g,'/')}
            </time>
            <h3 style="font-size:1rem; font-weight:400; margin:0;">
              <a href={`${prefix}/blog/${getPostSlug(post)}`} class="archive-title link-underline">
                {post.data.title}
              </a>
            </h3>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
