---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Divider from './Divider.astro';
import Mermaid from './Mermaid.astro';

interface Props {
  lang: 'zh' | 'en';
  altHref: string;
}

const { lang, altHref } = Astro.props;

const rawNotes = (await getCollection('notes'))
  .filter(n => n.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const notes = await Promise.all(
  rawNotes.map(async (note) => {
    const { Content } = await render(note);
    return { note, Content };
  })
);

const title = lang === 'zh' ? '随笔' : 'Notes';
const emptyText = lang === 'zh' ? '暂无随笔。' : 'No notes yet.';
---
<Base title={title} lang={lang} altHref={altHref}>
  <Header lang={lang} />
  <main class="section-divider">
    <section class="section-shell">
      <header class="section-header">
        <h1 class="section-title">{title}</h1>
        <Divider />
      </header>

      {notes.length === 0 && (
        <p class="text-center text-slate-400 text-sm">{emptyText}</p>
      )}

      <div class="note-timeline">
        {notes.map(({ note, Content }) => (
          <div class="note-item">
            <div class="note-date">
              {note.data.date.toISOString().slice(0,10).replace(/-/g,'/')}
              {note.data.title && (
                <span style="margin-left:0.5rem; color:#64748b; font-weight:500;">{note.data.title}</span>
              )}
            </div>
            <div class="note-body prose-shiro prose prose-slate">
              <Content />
            </div>
            {note.data.tags && note.data.tags.length > 0 && (
              <div class="note-footer">
                {note.data.tags.map((tag: string) => (
                  <span class="note-tag">#{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
      <Mermaid />
    </section>
  </main>
  <Footer />
</Base>
